# Agentic OS — systemd user service
# Install: cp deploy/agentic-os.service ~/.config/systemd/user/
# Enable:  systemctl --user daemon-reload
#          systemctl --user enable --now agentic-os
# Persist: loginctl enable-linger <username>
# Logs:    journalctl --user -u agentic-os -f
# Tailnet: http://<tailscale-ip>:3017

[Unit]
Description=Agentic OS Dashboard
After=network.target

[Service]
WorkingDirectory=%h/agentic-os
Environment=NODE_ENV=production
Environment=PATH=%h/.hermes/node/bin:%h/.hermes/hermes-agent/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
EnvironmentFile=-%h/.agentic-os.env
# Keep the dashboard reachable over Tailscale without binding every interface.
Environment=AGENTIC_HOST=tailscale
ExecStart=/usr/bin/env AGENTIC_HOST=tailscale %h/.hermes/node/bin/node server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
